# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Public site URL (used to build absolute QR tracking links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PostgreSQL (primary database) ---
DATABASE_URL=postgresql://user:password@localhost:5432/khaiati
DATABASE_SSL=false

# --- Supabase (auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Worker CDN proxy for images ---
# Public base URL the app builds image src="" from, e.g. https://cdn.khaiati.com
NEXT_PUBLIC_CDN_BASE_URL=
# Shared secret the Next.js server uses to authenticate upload requests to the worker.
CLOUDFLARE_CDN_UPLOAD_SECRET=
